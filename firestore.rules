rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function isSeller() { return signedIn() && me().role == 'seller'; }

    // Profiles: readable by signed-in users (buyers see farmer details),
    // editable only by the owner, and the role can never change.
    match /users/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid
                    && request.resource.data.role in ['buyer', 'seller']
                    && (request.resource.data.role == 'buyer'
                        || request.resource.data.pincode.matches('^[1-9][0-9]{5}$'));
      allow update: if signedIn() && request.auth.uid == uid
                    && request.resource.data.role == resource.data.role;
      allow delete: if false;
    }

    // Products: anyone signed in can browse; only the seller who owns a
    // product can create, change or delete it.
    match /products/{productId} {
      allow read: if signedIn();
      allow create: if isSeller()
                    && request.resource.data.sellerId == request.auth.uid
                    && request.resource.data.price > 0
                    && request.resource.data.quantity > 0;
      allow update: if signedIn()
                    && resource.data.sellerId == request.auth.uid
                    && request.resource.data.sellerId == request.auth.uid;
      allow delete: if signedIn() && resource.data.sellerId == request.auth.uid;
    }

    // Enquiries: visible only to the buyer who sent it and the seller it is
    // for. Buyers create; sellers may only change the status.
    match /enquiries/{enquiryId} {
      allow read: if signedIn()
                  && (resource.data.buyerId == request.auth.uid
                      || resource.data.sellerId == request.auth.uid);
      allow create: if signedIn()
                    && request.resource.data.buyerId == request.auth.uid
                    && request.resource.data.status == 'new';
      allow update: if signedIn()
                    && resource.data.sellerId == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow delete: if false;
    }
  }
}
